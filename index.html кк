<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CityFlow AI — Цифровая Экосистема</title>
    <style>
        :root {
            --egov-blue: #005baa;
            --ai-purple: #6c5ce7;
            --bg: #f0f4f8;
            --white: #ffffff;
            --text: #2d3436;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        header {
            background: var(--white);
            border-bottom: 4px solid var(--egov-blue);
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .container { max-width: 1000px; margin: 30px auto; padding: 0 20px; }

        .card {
            background: var(--white);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            position: relative;
            overflow: hidden;
        }

        /* Декор в стиле AI */
        .card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 5px; height: 100%;
            background: var(--egov-blue);
        }

        .card-ai::before { background: var(--ai-purple); }

        h2, h3 { color: var(--egov-blue); margin-top: 0; }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #dfe6e9;
            border-radius: 8px;
            box-sizing: border-box;
            background: #fdfdfd;
        }

        button {
            background: var(--egov-blue);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        button:hover { filter: brightness(1.1); transform: translateY(-2px); }

        .ai-badge {
            background: var(--ai-purple);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 10px;
        }

        .status {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: bold;
            margin-top: 10px;
        }

        .st-view { background: #dfe6e9; }
        .st-ok { background: #55efc4; color: #00b894; }
        .st-no { background: #fab1a0; color: #d63031; }

        .photo-preview {
            width: 100%;
            max-height: 350px;
            object-fit: cover;
            border-radius: 12px;
            margin: 15px 0;
            border: 2px solid var(--ai-purple);
        }

        .view { display: none; }
        .active { display: block; }

        .ai-analysis-box {
            background: #f8f9ff;
            border: 1px dashed var(--ai-purple);
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<header>
    <div style="display:flex; align-items:center; gap:10px">
        <img src="https://egov.kz/cms/ptl/img/logo.png" height="35">
        <b style="font-size:20px">CityFlow <span style="color:var(--ai-purple)">AI</span></b>
    </div>
    <button id="logoutBtn" style="display:none; background:#d63031" onclick="logout()">Выйти</button>
</header>

<div class="container">

    <div id="view-login" class="view active">
        <div class="card" style="max-width:450px; margin: 50px auto; border-top: 5px solid var(--egov-blue)">
            <h3 style="text-align:center">Цифровая идентификация</h3>
            <label>Ваше Имя</label>
            <input id="login-name" placeholder="Введите имя">
            <label>Ваш ИИН</label>
            <input id="login-iin" placeholder="12 цифр">
            <button onclick="login()" style="width:100%">Войти в систему</button>
            <p style="font-size:12px; color:#636e72; margin-top:15px">
                * ИИН администратора: 999999999999<br>
                * ИИН работника: 222222222222
            </p>
        </div>
    </div>

    <div id="view-citizen" class="view">
        <h2 id="user-greeting">Добро пожаловать</h2>
        <div class="card card-ai">
            <span class="ai-badge">AI Модуль включен</span>
            <h3>Новое обращение</h3>
            <label>Место жительства (Адрес)</label>
            <input id="req-address" placeholder="Например: ул. Абая 10, кв 5">
            <label>Категория</label>
            <select id="req-cat">
                <option value="Дороги">Дороги и ямы</option>
                <option value="Освещение">Не работает фонарь</option>
                <option value="Мусор">Свалка / Мусор</option>
            </select>
            <label>Суть проблемы</label>
            <textarea id="req-desc" rows="3" placeholder="Опишите ситуацию..."></textarea>
            <label>Загрузить фото</label>
            <input type="file" id="req-file" accept="image/*">
            <button onclick="submitRequest()">Отправить в обработку</button>
        </div>
        <h3>Мои заявки</h3>
        <div id="citizen-list"></div>
    </div>

    <div id="view-admin" class="view">
        <h2>Модерация обращений</h2>
        <div id="admin-list"></div>
    </div>

    <div id="view-worker" class="view">
        <h2>Технический отдел</h2>
        <div id="worker-list"></div>
    </div>

</div>

<script>
    // Имитация ИИ-логики
    const aiBrains = {
        "Дороги": { advice: "ИИ советует: Сделайте фото под углом 45 градусов, чтобы была видна глубина ямы. На фото рекомендуется добавить объект для масштаба.", budget: "200,000 - 1,500,000 ₸" },
        "Освещение": { advice: "ИИ советует: Сфотографируйте номер столба и общий план улицы в сумерках. Анализ показывает износ кабельной линии 60%.", budget: "45,000 - 120,000 ₸" },
        "Мусор": { advice: "ИИ советует: Сфотографируйте подъездные пути. Требуется оценка объема в кубических метрах.", budget: "15,000 - 80,000 ₸" }
    };

    function login() {
        const iin = document.getElementById('login-iin').value;
        const name = document.getElementById('login-name').value || "Пользователь";
        
        if(iin.length < 12) return alert("Введите корректный ИИН");

        let role = "citizen";
        if(iin === "999999999999") role = "admin";
        if(iin === "222222222222") role = "worker";

        const user = { iin, name, role };
        localStorage.setItem('city_user', JSON.stringify(user));
        render();
    }

    function logout() {
        localStorage.removeItem('city_user');
        location.reload();
    }

    async function submitRequest() {
        const user = JSON.parse(localStorage.getItem('city_user'));
        const address = document.getElementById('req-address').value;
        const cat = document.getElementById('req-cat').value;
        const desc = document.getElementById('req-desc').value;
        const file = document.getElementById('req-file').files[0];

        if(!address || !desc) return alert("Заполните адрес и описание!");

        const img = file ? await toBase64(file) : null;
        
        // AI Анализ в момент отправки
        const aiAnalysis = aiBrains[cat].advice;

        const req = {
            id: Date.now(),
            name: user.name,
            address,
            cat,
            desc,
            img,
            aiAnalysis,
            status: "Рассматривается",
            adminComment: "",
            date: new Date().toLocaleString()
        };

        const list = JSON.parse(localStorage.getItem('city_reqs')) || [];
        list.push(req);
        localStorage.setItem('city_reqs', JSON.stringify(list));
        alert("Заявка принята AI-системой!");
        render();
    }

    function render() {
        const user = JSON.parse(localStorage.getItem('city_user'));
        if(!user) return;

        document.getElementById('view-login').classList.remove('active');
        document.getElementById('logoutBtn').style.display = "block";
        const reqs = JSON.parse(localStorage.getItem('city_reqs')) || [];

        if(user.role === 'citizen') {
            document.getElementById('view-citizen').classList.add('active');
            document.getElementById('user-greeting').innerText = `Гражданин: ${user.name}`;
            const myList = reqs.filter(r => r.name === user.name);
            document.getElementById('citizen-list').innerHTML = myList.map(r => `
                <div class="card">
                    <span class="status st-view">${r.status}</span>
                    <h3>${r.cat}</h3>
                    <p><b>Адрес:</b> ${r.address}</p>
                    <p>${r.desc}</p>
                    ${r.img ? `<img src="${r.img}" class="photo-preview">` : ''}
                    <div class="ai-analysis-box">
                        <span class="ai-badge">AI Рекомендация</span><br>
                        ${r.aiAnalysis}
                    </div>
                    ${r.adminComment ? `<div class="card" style="background:#fff9e6; margin-top:10px"><b>Комментарий акимата:</b> ${r.adminComment}</div>` : ''}
                </div>
            `).reverse().join('');
        }

        if(user.role === 'admin') {
            document.getElementById('view-admin').classList.add('active');
            document.getElementById('admin-list').innerHTML = reqs.map(r => `
                <div class="card">
                    <b>От: ${r.name} | ${r.address}</b>
                    <p>${r.desc}</p>
                    <select onchange="updateReq(${r.id}, {status: this.value})">
                        <option ${r.status==='Рассматривается'?'selected':''}>Рассматривается</option>
                        <option ${r.status==='Одобрено'?'selected':''}>Одобрено</option>
                        <option ${r.status==='Отказ'?'selected':''}>Отказ</option>
                    </select>
                    <textarea placeholder="Ваш комментарий..." onblur="updateReq(${r.id}, {adminComment: this.value})">${r.adminComment}</textarea>
                </div>
            `).join('');
        }

        if(user.role === 'worker') {
            document.getElementById('view-worker').classList.add('active');
            document.getElementById('worker-list').innerHTML = reqs.filter(r => r.status === "Одобрено").map(r => `
                <div class="card card-ai">
                    <span class="ai-badge">AI Финансовый Анализ</span>
                    <h4>Объект: ${r.cat} (${r.address})</h4>
                    <p><b>Прогноз бюджета:</b> ${aiBrains[r.cat].budget}</p>
                    <p><b>Рекомендация по исправлению:</b> Сверка фото с ГОСТ-стандартами выявила необходимость привлечения ${r.cat === 'Дороги' ? 'асфальтоукладчика' : 'электрика'}.</p>
                    <button onclick="alert('Бригада сформирована')">Сформировать бригаду</button>
                </div>
            `).join('');
        }
    }

    function updateReq(id, data) {
        let list = JSON.parse(localStorage.getItem('city_reqs'));
        const idx = list.findIndex(r => r.id === id);
        list[idx] = {...list[idx], ...data};
        localStorage.setItem('city_reqs', JSON.stringify(list));
        if(data.status) render();
    }

    const toBase64 = file => new Promise((resolve) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result);
    });

    window.onload = render;
</script>
</body>
</html>
      
